  "private": true,
  "//overrides": "expo-quick-actions@6.0.2 bundles @expo/require-utils@55.x, whose optional typescript peer is capped at ^5 and so conflicts with the SDK 57 template's typescript ~6.0.3. npm 11 skips the optional peer; the older npm on EAS build images tries to resolve it and then fails `npm ci` with 'Missing: typescript@5.9.3 from lock file'. Pinning to the 57.x line the rest of the project already uses removes the duplicate and the stale peer range with it.",
  "overrides": {
    "@expo/require-utils": "^57.0.4"
  }
